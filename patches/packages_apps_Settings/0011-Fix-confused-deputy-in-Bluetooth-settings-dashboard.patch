+package com.android.settings.connecteddevice;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public class BluetoothDashboardFragmentVulnerabilityTest {
+    private static final String SETTINGS_PACKAGE_NAME = "com.android.settings";
+    private static final String EXTERNAL_APP_PACKAGE_NAME = "com.external.app";
+    private static final String TEST_ACTION = "android.settings.BLUETOOTH_DASHBOARD_SETTINGS";
+
+    private BluetoothDashboardFragment mFragment;
+
+    @Before
+    public void setUp() {
+        mFragment = new BluetoothDashboardFragment();
+    }
+
+    @Test
+    public void isAlwaysDiscoverable_initialPackageIsSettings_returnsTrue() {
+        // This simulates the case where resolveInitialCallingPackage() returns Settings.
+        // It should still return true because Settings is trusted.
+        assertThat(mFragment.isAlwaysDiscoverable(SETTINGS_PACKAGE_NAME, TEST_ACTION)).isTrue();
+    }
+
+    @Test
+    public void isAlwaysDiscoverable_initialPackageIsExternal_returnsFalse() {
+        // This simulates the case where resolveInitialCallingPackage() returns the external app.
+        // It should return false because the external app is not trusted.
+        assertThat(mFragment.isAlwaysDiscoverable(EXTERNAL_APP_PACKAGE_NAME, TEST_ACTION))
+                .isFalse();
+    }
+}
