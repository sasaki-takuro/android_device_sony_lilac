From: Mihai Stancu <mihaistancu@google.com>
Date: Mon, 6 Apr 2026 16:43:15 +0000
Subject: [PATCH 10/13] Sanitize package labels in SettingsApplication

Forces all loadLabel() calls to sanitize package labels
globally by invoking PackageItemInfo.forceSafeLabels()
during onCreate().

Bug: 488559440
Test: manual
Flag: EXEMPT BUGFIX
Cherrypick-From: https://googleplex-android-review.googlesource.com/q/commit:b3f1b5eee50441d14466f493af93693ffd3e1176
Merged-In: I8ce8a122a473df7282eef283b1b13ce33c2ad9a3
Change-Id: I8ce8a122a473df7282eef283b1b13ce33c2ad9a3
---
 src/com/android/settings/SettingsApplication.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/com/android/settings/SettingsApplication.java b/src/com/android/settings/SettingsApplication.java
index 99d3d922a0c..e8016b9d05b 100644
--- a/src/com/android/settings/SettingsApplication.java
+++ b/src/com/android/settings/SettingsApplication.java
@@ -18,6 +18,7 @@ package com.android.settings;
 
 import android.app.Application;
 import android.content.Context;
+import android.content.pm.PackageItemInfo;
 import android.content.pm.PackageManager;
 import android.database.ContentObserver;
 import android.hardware.fingerprint.FingerprintManager;
@@ -74,6 +75,9 @@ public class SettingsApplication extends Application {
     public void onCreate() {
         super.onCreate();
 
+        // Force all loadLabel() calls to sanitize package labels
+        PackageItemInfo.forceSafeLabels();
+
         if (Flags.catalyst()) {
             PreferenceScreenRegistry.INSTANCE.setPreferenceScreensSupplier(
                     this::getPreferenceScreens);
