-            if(_rendererHasBeenSet) _mSurfaceView._mRenderer.parallaxMove(x, y, _mSurfaceView.reversed, true);
+            final int dx = previousOffset - xPixelOffset;
             previousOffset = xPixelOffset;
+
+            final int moveX, moveY;
+            if (getResources().getConfiguration().orientation != Configuration.ORIENTATION_PORTRAIT) {
+                moveX = 0;
+                moveY = (int) (dx * 0.1f);
+            } else {
+                moveY = 0;
+                moveX = (int) (dx * 0.1f);
+            }
+
+            if (_rendererHasBeenSet && _mSurfaceView != null) {
+                final boolean reversed = _mSurfaceView.reversed;
+                _mSurfaceView.queueEvent(new Runnable() {
+                    @Override
+                    public void run() {
+                        if (_mSurfaceView != null && _mSurfaceView._mRenderer != null) {
+                            _mSurfaceView._mRenderer.parallaxMove(moveX, moveY, reversed, true);
