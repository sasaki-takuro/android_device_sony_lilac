diff --git a/app/src/main/res/raw/mainfragmenthader.glsl b/app/src/main/res/raw/mainfragmenthader.glsl
index 0a2a030..f38a802 100644
--- a/app/src/main/res/raw/mainfragmenthader.glsl
+++ b/app/src/main/res/raw/mainfragmenthader.glsl
@@ -1,22 +1,29 @@
 precision mediump float;
 
-uniform vec3 lightPosition;
-uniform sampler2D mask;
 uniform sampler2D texture;
-uniform sampler2D bumptexture;
+uniform sampler2D mask;
 uniform vec2 offset;
+uniform vec3 lightPosition;
 
 varying vec3 FragPos;
 varying vec2 TexCoords;
 
-
 void main()
 {
-	mat3 tbn = (mat3(vec3(1,0,0), vec3(0,1,0), vec3(0,0,-1)));
-	vec3 norm = tbn * normalize(texture2D(bumptexture, TexCoords + offset ).rgb * 2.0 - 1.0);
-	float dist = length(FragPos - lightPosition);
-    vec3 lightDir = normalize(lightPosition - vec3(FragPos.x, FragPos.y, 0));
-    float diff = max(dot(norm, lightDir), 0.0);
-	float light = (diff * 0.02)/ ((dist * (dist)));
-	gl_FragColor = mix((texture2D(texture, TexCoords + offset))* light, texture2D(mask, TexCoords + offset), (texture2D(mask, TexCoords + offset)).a);
-}
\ No newline at end of file
+    highp vec2 uv = fract(TexCoords + offset);
+
+    vec4 texColor = texture2D(texture, uv);
+    vec4 maskColor = texture2D(mask, uv);
+
+    // 距離フォールオフ (中心 d=0 で 1.0)
+    float d = distance(FragPos.xy, lightPosition.xy);
+    float spot = 1.0 / (1.0 + 28.0 * d * d);
+
+    // 中心部で最大 1.0 を超えないよう調整し白飛びを防止
+    float light = clamp((spot - 0.06) * 1.06, 0.0, 1.0);
+
+    // mask のアルファ (格子の黒線部分) を反転乗算してグリッド線を合成
+    vec3 litColor = texColor.rgb * (1.0 - maskColor.a) * light;
+
+    gl_FragColor = vec4(litColor, 1.0);
+}
