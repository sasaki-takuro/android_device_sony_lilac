From: Takuro <ssk.ktai@gmail.com>
Date: Sun, 15 Nov 2026 09:23:05 +0900
Subject: [PATCH 1/5] AconfigFlags: Fallback to proto flag storage when new
 storage is unavailable

Change-Id: I3977509faefaff0e8755bf9ad53ae0eab8f0b183
---
 .../com/android/internal/pm/pkg/component/AconfigFlags.java   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java b/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
index 7503fb1f9..f9aba5c5e 100644
--- a/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
+++ b/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
@@ -102,8 +102,8 @@ public class AconfigFlags {
     }
 
     private static boolean useNewStorage() {
-        return newStoragePublicApi() && Flags.useNewAconfigStorage() &&
-                Environment.getMetadataDirectory().exists();
+        // Legacy devices without /metadata aconfig storage fall back to proto flag files.
+        return false;
     }
 
     private void loadServerOverrides() {
