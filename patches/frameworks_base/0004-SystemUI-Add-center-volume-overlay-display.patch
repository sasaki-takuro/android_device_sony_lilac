+    private fun CoroutineScope.bindCenterVolumeOverlay() {
+        val windowManager = appContext.getSystemService(WindowManager::class.java) ?: return
+        var overlayView: View? = null
+        var overlayText: TextView? = null
+
+        fun hideOverlay() {
+            overlayView?.let { view ->
+                if (view.parent != null) {
+                    runCatching { windowManager.removeViewImmediate(view) }
+                }
+            }
+            overlayView = null
+            overlayText = null
+        }
+
+        fun showOrUpdateOverlay(level: Int, min: Int, max: Int) {
+            val textView = overlayText ?: TextView(appContext).apply {
+                setBackgroundResource(R.drawable.volume_center_bg)
+                setTextColor(android.graphics.Color.WHITE)
+                textSize = 22f
+                typeface = android.graphics.Typeface.DEFAULT_BOLD
+                val padH = (24 * appContext.resources.displayMetrics.density).toInt()
+                val padV = (14 * appContext.resources.displayMetrics.density).toInt()
+                setPadding(padH, padV, padH, padV)
+                gravity = Gravity.CENTER
+            }.also { created ->
+                val lp = WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.WRAP_CONTENT,
+                    WindowManager.LayoutParams.WRAP_CONTENT,
+                    WindowManager.LayoutParams.TYPE_VOLUME_OVERLAY,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                        WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or
+                        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                    PixelFormat.TRANSLUCENT,
+                ).apply {
+                    gravity = Gravity.CENTER
+                    title = "VolumeCenterOverlay"
+                }
+                windowManager.addView(created, lp)
+                overlayView = created
+                overlayText = created
+            }
+            val pct = if (max > min) ((level - min) * 100) / (max - min) else 0
+            textView.text = "$level / $max ($pct%)"
+            textView.visibility = View.VISIBLE
+        }
+
+        launchTraced("VDVB#centerVolumeOverlay") {
+            try {
+                kotlinx.coroutines.flow.combine(
+                    viewModel.dialogVisibilityModel,
+                    viewModel.activeStreamModel,
+                ) { visibility, streamModel -> visibility to streamModel }
+                    .collect { (visibility, streamModel) ->
+                        if (visibility is VolumeDialogVisibilityModel.Visible && streamModel != null) {
+                            val isRing = streamModel.stream == AudioManager.STREAM_RING
+                            val effectiveLevel = if (streamModel.muted && !isRing) 0 else streamModel.level
+                            showOrUpdateOverlay(effectiveLevel, streamModel.levelMin, streamModel.levelMax)
+                        } else {
+                            hideOverlay()
+                        }
+                    }
+            } finally {
+                hideOverlay()
+            }
+        }
+    }
