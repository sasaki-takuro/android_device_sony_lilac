From ba7f09128b4a64f7d631621ced76541d9fd83ae7 Mon Sep 17 00:00:00 2001
From: Takuro <ssk.ktai@gmail.com>
Date: Sun, 15 Nov 2026 11:04:57 +0900
Subject: [PATCH 1/2] fsgen: Skip internal module creation if not using Soong
 system image

Change-Id: I6b8da718e0b02d9ccde295fd5a6eddfb1b63230a
---
 fsgen/filesystem_creator.go | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/fsgen/filesystem_creator.go b/fsgen/filesystem_creator.go
index 1fd7d208b..2460dc7f5 100644
--- a/fsgen/filesystem_creator.go
+++ b/fsgen/filesystem_creator.go
@@ -260,6 +260,9 @@ func generatedPartitions(ctx android.EarlyModuleContext) allGeneratedPartitionDa
 }
 
 func (f *filesystemCreator) createInternalModules(ctx android.LoadHookContext) {
+    if !ctx.Config().UseSoongSystemImage() {
+        return
+    }
 	partitions := generatedPartitions(ctx)
 	for i := range partitions {
 		f.createPartition(ctx, partitions, &partitions[i])
@@ -1318,7 +1321,7 @@ func createRecoveryBuildProp(ctx android.LoadHookContext) string {
 	moduleName := generatedModuleName(ctx.Config(), "recovery-prop.default")
 
 	var vendorBuildProp *string
-	if ctx.DeviceConfig().BuildingVendorImage() && ctx.DeviceConfig().VendorPath() == "vendor" {
+	if ctx.Config().UseSoongSystemImage() && ctx.DeviceConfig().BuildingVendorImage() && ctx.DeviceConfig().VendorPath() == "vendor" {
 		vendorBuildProp = proptools.StringPtr(":" + generatedModuleName(ctx.Config(), "vendor-build.prop"))
 	}
 
