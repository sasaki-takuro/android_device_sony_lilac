Subject: [PATCH] config: Disable GMS inclusion by default for vanilla build

---
 config/derpfest.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/config/derpfest.mk b/config/derpfest.mk
index a3c4a21c..4c5295ad 100644
--- a/config/derpfest.mk
+++ b/config/derpfest.mk
@@ -95,8 +95,8 @@ endif
 DONT_DEXPREOPT_PREBUILTS := true
 
 # Include GMS by default
-WITH_GMS := true
-$(call inherit-product, vendor/gms/products/gms.mk)
+# WITH_GMS := true
+# $(call inherit-product, vendor/gms/products/gms.mk)
 
 # Signing
 ifneq (eng,$(TARGET_BUILD_VARIANT))
