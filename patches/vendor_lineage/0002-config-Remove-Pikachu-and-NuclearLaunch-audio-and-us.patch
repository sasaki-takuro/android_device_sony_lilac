From 1df9050e35f40092a1e9e3f565c384376278c4f2 Mon Sep 17 00:00:00 2001
From: Takuro <ssk.ktai@gmail.com>
Date: Thu, 26 Nov 2026 09:05:15 +0900
Subject: [PATCH 2/2] config: Remove Pikachu and NuclearLaunch audio and use
 Argon notification sound

---
 config/common_mobile.mk                         |   2 +-
 config/lineage_audio.mk                         |   4 +---
 .../common/media/audio/alarms/NuclearLaunch.ogg | Bin 65601 -> 0 bytes
 .../media/audio/notifications/Pikachu.ogg       | Bin 23750 -> 0 bytes
 4 files changed, 2 insertions(+), 4 deletions(-)
 delete mode 100644 prebuilt/common/media/audio/alarms/NuclearLaunch.ogg
 delete mode 100644 prebuilt/common/media/audio/notifications/Pikachu.ogg

diff --git a/config/common_mobile.mk b/config/common_mobile.mk
index 18542f7f..7c1f617d 100644
--- a/config/common_mobile.mk
+++ b/config/common_mobile.mk
@@ -10,7 +10,7 @@ include vendor/lineage/config/lineage_audio.mk
 
 # Default notification/alarm sounds
 PRODUCT_PRODUCT_PROPERTIES += \
-    ro.config.notification_sound=Pikachu.ogg \
+    ro.config.notification_sound=Argon.ogg \
     ro.config.alarm_alert=Hassium.ogg
 
 # Apps
diff --git a/config/lineage_audio.mk b/config/lineage_audio.mk
index 46325c73..53ea2bd0 100644
--- a/config/lineage_audio.mk
+++ b/config/lineage_audio.mk
@@ -8,8 +8,7 @@ RINGTONE_PATH := vendor/lineage/prebuilt/common/media/audio/ringtones
 
 # Alarms
 PRODUCT_COPY_FILES += \
-    $(ALARM_PATH)/CyanAlarm.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/alarms/CyanAlarm.ogg \
-    $(ALARM_PATH)/NuclearLaunch.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/alarms/NuclearLaunch.ogg
+    $(ALARM_PATH)/CyanAlarm.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/alarms/CyanAlarm.ogg
 
 # Notifications
 PRODUCT_COPY_FILES += \
@@ -20,7 +19,6 @@ PRODUCT_COPY_FILES += \
     $(NOTIFICATION_PATH)/Naughty.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Naughty.ogg \
     $(NOTIFICATION_PATH)/Pong.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Pong.ogg \
     $(NOTIFICATION_PATH)/Rang.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Rang.ogg \
-    $(NOTIFICATION_PATH)/Pikachu.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Pikachu.ogg \
     $(NOTIFICATION_PATH)/Stone.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Stone.ogg
 
 # Ringtones
diff --git a/prebuilt/common/media/audio/alarms/NuclearLaunch.ogg b/prebuilt/common/media/audio/alarms/NuclearLaunch.ogg
deleted file mode 100644
index 00a4a83e3befc818a50df7e4403182d0c48b3735..0000000000000000000000000000000000000000
GIT binary patch
literal 0
