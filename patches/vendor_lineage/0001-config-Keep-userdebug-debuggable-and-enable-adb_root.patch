From 961e753bb2aa3ee08dd4257152155c7ad8fbe9b5 Mon Sep 17 00:00:00 2001
From: Takuro <ssk.ktai@gmail.com>
Date: Thu, 19 Nov 2026 22:27:32 +0900
Subject: [PATCH] config: Keep userdebug debuggable and enable adb_root

---
 config/common.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index d4efdc2c..8448e260 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -46,7 +46,7 @@ else
 PRODUCT_SYSTEM_EXT_PROPERTIES += ro.adb.secure=1
 
 # Set ro.debuggable=0 for userdebug
-PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG := true
+# PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG := true
 endif
 
 # Disable extra StrictMode features on all non-engineering builds
@@ -237,11 +237,11 @@ PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
 endif
 
 ifneq ($(TARGET_BUILD_VARIANT),user)
-ifeq ($(WITH_SU),true)
 # Root
 PRODUCT_PACKAGES += \
     adb_root
 
+ifeq ($(WITH_SU),true)
 PRODUCT_PACKAGES += \
     su
 
-- 
2.56.1

