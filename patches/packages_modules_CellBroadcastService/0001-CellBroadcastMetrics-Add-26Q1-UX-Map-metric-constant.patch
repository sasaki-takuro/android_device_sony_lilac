 .../CellBroadcastMetrics.java                     | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/com/android/cellbroadcastservice/CellBroadcastMetrics.java b/src/com/android/cellbroadcastservice/CellBroadcastMetrics.java
