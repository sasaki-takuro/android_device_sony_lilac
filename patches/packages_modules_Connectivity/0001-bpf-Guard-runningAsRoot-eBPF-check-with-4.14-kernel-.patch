From 894c1e4fd830a39a948f2ea4103ee8d77235f567 Mon Sep 17 00:00:00 2001
From: Takuro <ssk.ktai@gmail.com>
Date: Thu, 19 Nov 2026 04:21:44 +0900
Subject: [PATCH 1/3] bpf: Guard runningAsRoot eBPF check with 4.14+ kernel
 version

---
 bpf/loader/NetBpfLoad.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index d4d3aa3424..c5c8034eff 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1801,7 +1801,7 @@ static int doLoad(char** argv, char * const envp[]) {
         if (!createDir("/sys/fs/bpf/loader")) return 31;
     }
 
-    if (runningAsRoot) {  // implies U QPR3+ and kernel 4.14+
+    if (runningAsRoot && isAtLeastKernelVersion(4, 14)) {  // implies U QPR3+ and kernel 4.14+
         // There should not be any programs or maps yet
         errno = 0;
         uint32_t progId = bpfGetNextProgId(0);  // expect 0 with errno == ENOENT
-- 
2.56.1

